---
/**
 * ProcessAccordion - les 4 etapes du process en accordeon horizontal.
 *
 * Remplace StoryScroll et ses 4 StorySection plein ecran : meme contenu,
 * meme ordre, mais les 4 etapes sont visibles d'un coup au lieu de defiler
 * sur 4 ecrans. Supprime au passage 4 canvas ShaderGradient (three.js).
 *
 * Mecanique relevee sur calendly.com (section "Book / Prep / Capture /
 * Follow up", 2026-09-13) :
 *  - le declencheur est le SURVOL (pointerenter), pas le scroll ni le clic
 *  - carte active 384px, carte au repos 248px
 *  - transition flex-basis 500ms ease-in-out, ombre 180ms
 *  - le degrade vit dans une zone visuelle collee en bas, pas sur la carte
 *
 * Les degrades sont les posters ShaderGradient deja presents dans le projet,
 * un par etape, ceux-la memes qui servaient de fond aux StorySection.
 */

const ETAPES = [
  {
    key: 'cadrage',
    moment: 'Semaine 1',
    titre: 'On cadre votre cible.',
    desc: "Un atelier pour définir les segments visés, les angles de message et les critères d'exclusion. Vous validez le document stratégique avant que le moindre message parte.",
    bullets: [
      'Segments et personas arbitrés avec vous',
      "Critères d'exclusion : vos clients, votre pipe",
      'Document stratégique validé avant tout envoi',
    ],
    img: '/images/story-cadrage.webp',
    logos: ['linkedin.svg', 'clay.png'],
    accent: 'var(--color-orange)',
  },
  {
    key: 'infra',
    moment: 'Semaine 2',
    titre: 'Listes, copy, infrastructure.',
    desc: "Listes construites sur mesure, séquences rédigées et validées par vous mot par mot, domaines dédiés montés en réputation. Votre domaine principal n'est jamais exposé.",
    bullets: [
      'Listes construites sur mesure, adresses vérifiées',
      'Séquences validées par vous mot par mot',
      'Domaines dédiés, warmup 4 à 6 semaines',
    ],
    img: '/images/story-infra.webp',
    logos: ['instantly.png', 'usebouncer.png'],
    accent: 'var(--color-bleu)',
  },
  {
    key: 'lancement',
    moment: 'Semaines 3 à 6',
    titre: 'Lancement et itérations.',
    desc: 'Envois progressifs pour protéger la délivrabilité, arbitrages chaque semaine : on coupe ce qui ne répond pas, on double sur ce qui fonctionne.',
    bullets: [
      'Montée en volume progressive',
      'Arbitrage hebdomadaire sur les vrais chiffres',
      'On coupe ce qui ne répond pas',
    ],
    img: '/images/story-lancement.webp',
    logos: ['make.svg', 'claude.svg'],
    accent: 'var(--color-orange)',
  },
  {
    key: 'agenda',
    moment: 'Mois 2 et suivants',
    titre: 'Des RDV dans votre agenda.',
    desc: 'Chaque réponse positive est qualifiée puis transformée en rendez-vous posé dans votre agenda, avec le contexte complet. Reporting mensuel avec les vrais chiffres.',
    bullets: [
      'Réponses triées puis qualifiées',
      'Créneau posé avec le contexte complet',
      'Reporting mensuel sans maquillage',
    ],
    img: '/images/story-agenda.webp',
    logos: ['aimfox.svg'],
    accent: 'var(--color-bleu)',
  },
] as const;
---

<section class="pacc" aria-labelledby="pacc-title">
  <div class="pacc-wrap">
    <header class="pacc-head">
      <p class="pacc-eyebrow">Le process</p>
      <h2 id="pacc-title" class="pacc-title">
        De la première réunion au <em>premier rendez-vous posé</em>.
      </h2>
      <p class="pacc-sub">Survolez une étape pour voir ce qu'elle contient.</p>
    </header>

    <div class="pacc-row" id="pacc-row" role="tablist" aria-label="Les 4 étapes du process">
      {ETAPES.map((e, i) => (
        <article
          class="card"
          role="tab"
          tabindex="0"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-state={i === 0 ? 'active' : 'resting'}
          data-i={i}
          style={`--accent:${e.accent}`}
        >
          <div class="card-head">
            <p class="card-moment">{e.moment}</p>
            <h3 class="card-titre">{e.titre}</h3>

            {/* Deux couches de texte dans la MEME cellule de grille : la
                description au repos s'efface, les puces la remplacent.
                minmax(0,1fr) empeche la couche large d'elargir la grille et
                donc de tronquer la description. */}
            <div class="card-body">
              <p class="card-desc">{e.desc}</p>
              <ul class="card-acts">
                {e.bullets.map((b) => (
                  <li>
                    <span class="tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                    </span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* La scene : degrade, carte d'interface simplifiee qui flotte,
              logos qui debordent. Largeur figee sur la carte active pour que
              rien ne se recompose pendant les 500ms de transition. */}
          <div class="card-visual" aria-hidden="true">
            <img src={e.img} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
            <span class="veil"></span>

            <div class="scene">
              <div class="ui">
                {e.key === 'cadrage' && (
                  <>
                    <p class="ui-t">Qui vaut la peine d'être contacté</p>
                    <span class="crit"><b>Secteur</b>SaaS B2B</span>
                    <span class="crit"><b>Effectif</b>50 à 200</span>
                    <span class="crit"><b>Signal</b>levée &lt; 6 mois</span>
                    <span class="crit out"><b>Exclu</b>vos clients, votre pipe</span>
                  </>
                )}

                {e.key === 'infra' && (
                  <>
                    <p class="ui-row"><span class="ui-k">À</span>
                      <span class="pill"><i class="av"></i>Camille Dubois</span></p>
                    <p class="ui-row"><span class="ui-k">Objet</span>
                      <span class="ui-v">votre annonce Head of Sales</span></p>
                    <p class="ui-body">j'ai vu l'annonce publiée cette semaine, deux mois après votre Série A.</p>
                  </>
                )}

                {e.key === 'lancement' && (
                  <>
                    <p class="ui-t">Semaine 4</p>
                    <div class="kpi"><span class="kpi-n">11,4 %</span><span class="kpi-l">de réponse</span>
                      <span class="kpi-up">+3,1</span></div>
                    <div class="bars"><i style="height:34%"></i><i style="height:52%"></i><i style="height:44%"></i><i style="height:71%"></i><i style="height:88%"></i></div>
                  </>
                )}

                {e.key === 'agenda' && (
                  <>
                    <p class="ui-t">Mardi 9</p>
                    <span class="slot s1">10:00 · RDV qualifié, SaaS Fintech</span>
                    <span class="slot s2">14:30 · RDV qualifié, ESN</span>
                    <span class="slot s3">16:00 · RDV qualifié, Logistique</span>
                  </>
                )}
              </div>

              {e.logos.map((l, n) => (
                <span class={`logo l${e.logos.length === 1 ? 1 : n}`}>
                  <img src={`/logos/tools/${l}`} alt="" loading="lazy" />
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pacc {
    background: var(--color-creme);
    color: var(--color-encre);
    padding: 5rem 0 6rem;
    --w-active: 384px;
    --w-rest: 248px;
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pacc-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

  .pacc-head { text-align: center; margin-bottom: 3rem; }
  .pacc-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-orange);
    margin: 0;
  }
  .pacc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1rem auto 0;
    max-width: 22ch;
    text-wrap: balance;
  }
  .pacc-title em { font-style: italic; color: var(--color-bleu); }
  .pacc-sub {
    font-size: 1rem;
    color: color-mix(in srgb, var(--color-encre) 62%, transparent);
    margin: 1rem 0 0;
  }

  .pacc-row { display: flex; gap: 0; align-items: stretch; justify-content: center; }

  .card {
    flex: 0 0 var(--w-rest);
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 48px;
    overflow: hidden;
    position: relative;
    transition: flex-basis 0.5s ease-in-out, box-shadow 0.18s ease-in-out;
  }
  .card[data-state='active'] {
    flex: 0 0 var(--w-active);
    box-shadow: 0 20px 48px -12px rgba(11, 53, 88, 0.16);
    z-index: 2;
  }
  .card:focus-visible { outline: 2px solid var(--color-encre); outline-offset: 3px; }

  .card-head { padding: 2rem 2rem 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .card-moment {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .card-titre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.55rem;
    line-height: 1.14;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  .card-body { display: grid; grid-template-columns: minmax(0, 1fr); }
  .card-body > * { grid-area: 1 / 1; }
  .card-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-encre) 68%, transparent);
    margin: 0;
    transition: opacity 0.22s var(--ease);
  }
  .card-acts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    opacity: 0;
    width: calc(var(--w-active) - 4rem);
    pointer-events: none;
    transition: opacity 0.3s var(--ease) 0.14s;
  }
  .card-acts li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.82rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-encre) 74%, transparent);
  }
  .tick {
    flex: 0 0 17px;
    height: 17px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    margin-top: 1px;
  }
  .tick svg { width: 9px; height: 9px; color: #fff; }
  .card[data-state='active'] .card-desc { opacity: 0; }
  .card[data-state='active'] .card-acts { opacity: 1; pointer-events: auto; }

  /* --- la zone visuelle : le degrade ShaderGradient de l'etape ------------ */
  .card-visual { margin-top: auto; position: relative; height: 260px; overflow: hidden; background: #fff; }
  .card-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* au repos le degrade n'est qu'une trace pale : les cartes inactives de
       Calendly ne sont jamais blanches non plus */
    opacity: 0.4;
    filter: saturate(0.8);
    transition: opacity 0.45s ease-in-out, filter 0.45s ease-in-out;
  }
  .card[data-state='active'] .card-visual img {
    opacity: 1;
    filter: saturate(1);
    /* la derive : le degrade respire, mais seulement sur la carte active */
    animation: pacc-drift 26s ease-in-out infinite alternate;
  }
  @keyframes pacc-drift {
    from { scale: 1.06 1.06; translate: -1% 0; }
    to { scale: 1.16 1.16; translate: 1% -3%; }
  }
  /* blanc en haut vers couleur en bas : la structure relevee chez Calendly */
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #fff 4%, rgba(255, 255, 255, 0.62) 32%, rgba(255, 255, 255, 0) 100%);
  }

  /* ====================================================================
     LA SCENE : une carte d'interface simplifiee qui flotte sur le degrade,
     avec des logos qui debordent. Jamais une capture d'ecran : 4 elements
     maximum, du blanc, un seul chiffre lisible.
     ==================================================================== */
  .scene {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    transition: opacity 0.4s var(--ease);
  }
  .card[data-state='active'] .scene { opacity: 1; }

  .ui {
    position: absolute;
    top: 46px;
    left: 26px;
    /* largeur figee sur la carte active : rien ne se recompose pendant les
       500ms de transition, la carte au repos la laisse simplement deborder */
    width: calc(var(--w-active) - 3.25rem);
    bottom: -14px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 14px;
    box-shadow: 0 10px 30px -10px rgba(11, 53, 88, 0.28);
    padding: 0.85rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
    overflow: hidden;
  }
  .ui-t {
    font-size: 0.66rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-encre) 55%, transparent);
    margin: 0 0 0.12rem;
  }

  /* les logos qui debordent, comme les pastilles Gmail et Outlook de Calendly */
  .logo {
    position: absolute;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 6px 18px -4px rgba(11, 53, 88, 0.3);
    display: grid;
    place-items: center;
  }
  .logo img { width: 21px; height: 21px; object-fit: contain; }
  /* cales sur la carte d'interface (largeur figee), pas sur le bord de la
     carte : sinon ils se font couper des que la carte revient a 248px */
  /* Alignement : le bord droit du logo bas tombe exactement sur le bord droit
     de la carte d'interface (26px + sa largeur figee), et le logo haut est
     decale de 42px sur les DEUX axes. La diagonale est voulue, pas subie. */
  .logo.l1 { top: 52px; left: calc(var(--w-active) - 64px); }
  .logo.l0 { top: 10px; left: calc(var(--w-active) - 106px); }

  /* Au repos la carte ne fait que 248px : les logos tomberaient hors cadre et
     seraient tranches par overflow:hidden. Ils n'apparaissent donc qu'une fois
     la carte ouverte, quand la place existe. */
  .logo {
    opacity: 0;
    transition: opacity 0.26s var(--ease);
  }
  .card[data-state='active'] .logo {
    opacity: 1;
    transition: opacity 0.3s var(--ease) 0.26s;
  }

  /* --- etape 1 : les criteres de ciblage --- */
  .crit {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.68rem;
    line-height: 1.3;
    padding: 0.25rem 0.45rem;
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-bleu) 7%, transparent);
  }
  .crit b {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bleu);
    flex: 0 0 auto;
  }
  .crit.out { background: color-mix(in srgb, var(--color-orange) 9%, transparent); }
  .crit.out b { color: var(--color-orange); }

  /* --- etape 2 : le mail en cours de redaction --- */
  .ui-row { display: flex; align-items: center; gap: 0.45rem; margin: 0; font-size: 0.7rem; }
  .ui-k {
    font-size: 0.58rem;
    color: color-mix(in srgb, var(--color-encre) 45%, transparent);
    flex: 0 0 2.1rem;
  }
  .ui-v { font-weight: 500; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem 0.15rem 0.2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bleu) 10%, transparent);
    font-weight: 500;
  }
  .av {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--color-bleu), var(--color-orange));
  }
  .ui-body {
    font-size: 0.68rem;
    line-height: 1.4;
    margin: 0.25rem 0 0;
    padding-top: 0.4rem;
    border-top: 1px solid color-mix(in srgb, var(--color-encre) 9%, transparent);
    color: color-mix(in srgb, var(--color-encre) 78%, transparent);
  }

  /* --- etape 3 : le chiffre de la semaine --- */
  .kpi { display: flex; align-items: baseline; gap: 0.35rem; }
  .kpi-n {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .kpi-l { font-size: 0.64rem; color: color-mix(in srgb, var(--color-encre) 55%, transparent); }
  .kpi-up {
    margin-left: auto;
    font-size: 0.6rem;
    font-weight: 600;
    color: #1f9d76;
    background: rgba(31, 157, 118, 0.1);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
  }
  .bars { display: flex; align-items: flex-end; gap: 0.28rem; height: 42px; margin-top: 0.35rem; }
  .bars i {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: color-mix(in srgb, var(--color-orange) 32%, transparent);
  }
  .bars i:last-child { background: var(--color-orange); }

  /* --- etape 4 : les creneaux qui se posent --- */
  .slot {
    font-size: 0.66rem;
    font-weight: 500;
    padding: 0.32rem 0.5rem;
    border-radius: 7px;
    border-left: 3px solid var(--color-bleu);
    background: color-mix(in srgb, var(--color-bleu) 8%, transparent);
    white-space: nowrap;
  }
  /* le seul geste de la section : les creneaux se posent un par un quand la
     carte s'ouvre. C'est ce que vend Agence Simple. */
  .card[data-state='active'] .slot {
    animation: slot-in 0.42s var(--ease) backwards;
  }
  .card[data-state='active'] .s1 { animation-delay: 0.18s; }
  .card[data-state='active'] .s2 { animation-delay: 0.32s; }
  .card[data-state='active'] .s3 { animation-delay: 0.46s; }
  @keyframes slot-in {
    from { opacity: 0; translate: 0 8px; }
    to { opacity: 1; translate: 0 0; }
  }

  /* --- repli mobile : les 4 cartes empilees ------------------------------- */
  @media (max-width: 1100px) {
    .pacc-row { flex-direction: column; gap: 0.9rem; }
    .card,
    .card[data-state='active'] { flex: 1 1 auto; width: 100%; border-radius: 28px; box-shadow: none; }
    .card-desc { display: none; }
    .card-acts { opacity: 1; width: 100%; pointer-events: auto; }
    .card-visual { height: 230px; }
    .card-visual img { opacity: 1; filter: none; animation: none; }
    .scene { opacity: 1; }
    .ui { width: auto; right: 26px; }
    .logo { opacity: 1; }
    .logo.l1 { left: auto; right: 26px; }
    .logo.l0 { left: auto; right: 68px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card-desc, .card-acts, .card-visual img, .scene { transition: none; }
    .card[data-state='active'] .card-visual img,
    .card[data-state='active'] .slot { animation: none; }
  }
</style>

<script>
  (() => {
    const row = document.getElementById('pacc-row');
    if (!row) return;
    const cards = [...row.children] as HTMLElement[];
    const isDesktop = () => matchMedia('(min-width:1101px)').matches;

    const select = (i: number) =>
      cards.forEach((c, n) => {
        const on = n === i;
        c.dataset.state = on ? 'active' : 'resting';
        c.setAttribute('aria-selected', String(on));
      });

    cards.forEach((c, i) => {
      /* le declencheur de Calendly : le survol, pas le clic ni le scroll */
      c.addEventListener('pointerenter', () => { if (isDesktop()) select(i); });
      c.addEventListener('focus', () => { if (isDesktop()) select(i); });
      c.addEventListener('click', () => select(i));
      c.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        cards[(i + d + cards.length) % cards.length].focus();
      });
    });
  })();
</script>
